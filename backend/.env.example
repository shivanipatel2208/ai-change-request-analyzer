# --- App ---
APP_NAME="AI Change Request Analyzer"
APP_ENV=development
DEBUG=true

# --- Database ---
# SQLite file lives at backend/data/app.db by default (created automatically on startup)
DATABASE_URL=sqlite:///./data/app.db

# --- CORS ---
# Comma-separated list of origins allowed to call this API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider ---
# Which provider the AI abstraction layer should use. Currently supported: anthropic, gemini, ollama, openrouter
AI_PROVIDER=anthropic

# Anthropic (Claude) - requires a paid/billed API key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini - a free alternative that doesn't require billing to get
# started. Get a key at https://aistudio.google.com/apikey (just a Google
# account, no credit card), then set AI_PROVIDER=gemini above.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Ollama - runs entirely on this machine, no API key/signup/internet at
# all. Install Ollama (ollama.com), run `ollama pull llama3.2` (or another
# model), then set AI_PROVIDER=ollama above. Slower than a hosted API on a
# laptop CPU - consider raising AI_REQUEST_TIMEOUT_SECONDS below if you use
# this (e.g. 180).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI (reserved for a future provider implementation — not wired up yet)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# OpenRouter - one API key/endpoint that proxies many different models
# (Anthropic, OpenAI, Meta, Google, and more). Get a key at
# https://openrouter.ai/keys, then set AI_PROVIDER=openrouter above.
# Model names are OpenRouter's own slugs - see https://openrouter.ai/models
# (e.g. "openai/gpt-4o-mini", "anthropic/claude-3.5-sonnet").
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# How long (seconds) the AI Analysis Engine waits for one provider call
# before reporting a timeout back to the user.
AI_REQUEST_TIMEOUT_SECONDS=60

# --- Auth ---
# Signs login tokens (JWT). Module 22: a template file like this one should
# never ship a real, working secret (this file used to - if your own
# backend/.env still has that old committed value, generate a fresh one and
# replace it there). Generate your own random value and paste it below -
# from this backend/ folder:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Treat the value like a password: never share this file or commit your
# real backend/.env (it's already covered by .gitignore).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REMEMBER_ME_TOKEN_EXPIRE_MINUTES=43200

# --- Repository Intelligence (Module 15) ---
# Local folder path the analyzer should index/scan when matching change
# requests to source files. Leave blank (the default) to index this
# project's own repository - nothing to set up, it just works. Only set
# this if you want it to scan a different folder on your computer instead,
# e.g. REPOSITORY_ROOT=C:\Users\shiva\OneDrive\Desktop\some-other-project
REPOSITORY_ROOT=
